 xor(B_new[1], B[1], Cin);
 xor(B_new[2], B[2], Cin);
 xor(B_new[3], B[3], Cin);
  
 one_bit_full_adder_fa0(.A(A[0]), .B(B_new[0]), Cin(Cin), .S(S[0]), .Cout(c1));
 one_bit_full_adder_fa1(.A(A[1]), .B(B_new[1]), Cin(c1), .S(S[1]), .Cout(c3));
 one_bit_full_adder_fa2(.A(A[2]), .B(B_new[2]), Cin(c2), .S(S[2]), .Cout(c3));
