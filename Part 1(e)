module tb_four_bit_RCA_RCS;
 
    reg [3:0] A, B;
    reg Cin;
 
    wire [3:0] S;
    wire Cout;
 
    // Instantiate design under test
    four_bit_RCA_RCS dut(
        .A(A),
        .B(B),
        .Cin(Cin),
        .S(S),
        .Cout(Cout)
    );
 
    initial begin
        $dumpfile("dump.vcd");
        $dumpvars(0, tb_four_bit_RCA_RCS);
 
        $display(" A     B    Cin | S     Cout");
        $display("----------------------------");

        A = 4'b0100;
        B = 4'b0011;
        Cin = 0;
        #10;
        $display("%b  %b   %b  | %b    %b",
                 A, B, Cin, S, Cout);
 
        A = 4'b1001;
        B = 4'b0101;
        Cin = 1;
        #10;
        $display("%b  %b   %b  | %b    %b",
                 A, B, Cin, S, Cout);
 
        A = 4'b1101;   // -3
        B = 4'b0101;   // +5
        Cin = 0;
        #10;
        $display("%b  %b   %b  | %b    %b",
                 A, B, Cin, S, Cout);
 
        A = 4'b1101;   // -3
        B = 4'b0010;   // +2
        Cin = 1;
        #10;
        $display("%b  %b   %b  | %b    %b",
                 A, B, Cin, S, Cout);
 
        A = 4'b1111;
        B = 4'b0001;
        Cin = 0;
        #10;
        $display("%b  %b   %b  | %b    %b",
                 A, B, Cin, S, Cout);
        #10;
        $finish;
 
    end
endmodule

