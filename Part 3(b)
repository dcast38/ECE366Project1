module tb_PPA;
    reg [15:0] A, B;
    reg Cin;
    wire [15:0] S;
    wire Cout;
  
    PPA dut(.A(A), .B(B), .Cin(Cin), .S(S), .Cout(Cout));
  
    initial begin
        $dumpfile("dump.vcd");
        $dumpvars(0, tb_PPA);
        
        A = 16'd4;
        B = 16'd3;
        Cin = 0;
        #10;
        $display("A=%h B=%h Cin=%b | S=%h Cout=%b", A, B, Cin, S, Cout);

        A = 16'd9;
        B = 16'd5;
        Cin = 0;
        #10;
        $display("A=%h B=%h Cin=%b | S=%h Cout=%b", A, B, Cin, S, Cout);

        A = 16'hFFFD; // -3 in 16-bit two's complement
        B = 16'd5;
        Cin = 0;
        #10;
        $display("A=%h B=%h Cin=%b | S=%h Cout=%b", A, B, Cin, S, Cout);

        A = 16'hFFFD; // -3 in 16-bit two's complement
        B = 16'd2;
        Cin = 0;
        #10;
        $display("A=%h B=%h Cin=%b | S=%h Cout=%b", A, B, Cin, S, Cout);

        A = 16'hFFFF;
        B = 16'h0001;
        Cin = 0;
        #10;
        $display("A=%h B=%h Cin=%b | S=%h Cout=%b", A, B, Cin, S, Cout);

        A = 16'h00FF;
        B = 16'h0001;
        Cin = 0;
        #10;
        $display("A=%h B=%h Cin=%b | S=%h Cout=%b", A, B, Cin, S, Cout);

        #10;
        $finish;
    end
endmodule
